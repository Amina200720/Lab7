with open("massiv.txt", "r") as f:
    ədəd_sətiri = f.read()
    ədədlər = list(map(int, ədəd_sətiri.split()))
müsbət_ədədlər = [x for x in ədədlər if x > 0]
cem = sum(müsbət_ədədlər)
with open("musbetler.txt", "w") as f:
    f.write(" ".join(map(str, müsbət_ədədlər)))
print("Müsbət ədədlər:", müsbət_ədədlər)
